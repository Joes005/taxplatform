# --- Application ---
ENVIRONMENT=development
APP_NAME="Tax Compliance & Audit Support Platform"
API_V1_PREFIX=/api/v1

# --- Database ---
# Used by the running application (async driver)
DATABASE_URL=postgresql+asyncpg://taxplatform:taxplatform@postgres:5432/taxplatform
# Used by Alembic migrations (sync driver)
DATABASE_URL_SYNC=postgresql+psycopg2://taxplatform:taxplatform@postgres:5432/taxplatform

# --- JWT / Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Seed / Bootstrap Super Admin (development only) ---
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
SEED_SUPER_ADMIN_FIRST_NAME=Platform
SEED_SUPER_ADMIN_LAST_NAME=Admin
